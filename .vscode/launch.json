{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Django Backend",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/octofit-tracker/backend",
      "program": "manage.py",
      "args": ["runserver", "0.0.0.0:8000"],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "python": "${command:python.interpreterPath}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/octofit-tracker/backend",
        "VIRTUAL_ENV": "${workspaceFolder}/octofit-tracker/backend/venv",
        "PATH": "${workspaceFolder}/octofit-tracker/backend/venv/bin:${env:PATH}"
      }
    },
    {
      "name": "Launch React Frontend",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/octofit-tracker/frontend",
      "command": "npm run start:lab",
      "serverReadyAction": {
        "pattern": "You can now view .* in the browser\\.",
        "uriFormat": "https://${env:CODESPACE_NAME}-3000.app.github.dev",
        "action": "openExternally"
      },
      "env": {
        "HOST": "0.0.0.0",
        "PORT": "3000",
        "BROWSER": "none",
        "REACT_APP_CODESPACE_NAME": "${env:CODESPACE_NAME}"
      }
    }
  ]
}